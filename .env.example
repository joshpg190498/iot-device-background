# fedsbc device config (one per SBC).
# Copy to .env, fill in the empty values and run:  sudo ./deploy/install.sh
# The installer copies it to /opt/fedsbc/etc/fedsbc.env. To change a value,
# edit this .env and run the installer again.

## Device identity (must exist in the DEVICES table on the server)
ID_DEVICE=

## MQTT broker on the server (protocol: mqtt or ssl)
MQTT_PROTOCOL=ssl
MQTT_HOST=
MQTT_PORT=8883

## Model deployment: server that serves the model files
SERVER_HTTP_BASE=
DOWNLOAD_TIMEOUT_SEC=600

## Federated learning (Flower)
# SuperLink address on the server: IP:9192 (port 9092 is used by Kafka)
SUPERLINK=
# Data partition of this node in the experiments: 0 .. NUM_PARTITIONS-1
PARTITION_ID=
NUM_PARTITIONS=

## Paths for local development (go run). The installer replaces them with
## /opt/fedsbc/certs, /opt/fedsbc/models and /opt/fedsbc/var/agent.sqlite
CERTS_DIR=./certs
MODELS_DIR=./models
SQLITE_DB_PATH=./agent.sqlite
